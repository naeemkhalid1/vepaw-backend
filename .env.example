# ──────────────────────────────────────────────
# App
# ──────────────────────────────────────────────
PORT=3000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:3003

# Base of the app's registered deep link (scheme + host) used to build the redirect_url/
# cancel_url sent to Safepay's hosted checkout — appointments/consultations append /callback,
# e.g. vepaw://payment/callback?type=appointment&id=...&result=success
FRONTEND_BASE_URL=vepaw://payment

# ──────────────────────────────────────────────
# MongoDB
# ──────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/vepaw

# ──────────────────────────────────────────────
# JWT
# ──────────────────────────────────────────────
JWT_ACCESS_SECRET=change_this_access_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_this_refresh_secret_min_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# ──────────────────────────────────────────────
# Redis
# ──────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ──────────────────────────────────────────────
# OTP
# ──────────────────────────────────────────────
OTP_TTL_SECONDS=60
MAX_OTP_ATTEMPTS=3

# ──────────────────────────────────────────────
# Anthropic (LLM / symptom-check)
# ──────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ──────────────────────────────────────────────
# Firebase Cloud Messaging (FCM)
# ──────────────────────────────────────────────
FCM_PROJECT_ID=your-firebase-project-id
FCM_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n"

# ──────────────────────────────────────────────
# Safepay (Express Checkout — appointments + consultations)
# ──────────────────────────────────────────────
SAFEPAY_ENVIRONMENT=sandbox
SAFEPAY_PUBLIC_KEY=your_safepay_public_key
SAFEPAY_SECRET_KEY=your_safepay_secret_key
SAFEPAY_WEBHOOK_SECRET=your_safepay_webhook_shared_secret

# ──────────────────────────────────────────────
# Google Maps
# ──────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# ──────────────────────────────────────────────
# Agora (video calls)
# ──────────────────────────────────────────────
AGORA_APP_ID=your_agora_app_id
AGORA_APP_CERTIFICATE=your_agora_app_certificate

# ──────────────────────────────────────────────
# Cloudinary (file storage)
# ──────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ──────────────────────────────────────────────
# AWS S3 (file storage)
# ──────────────────────────────────────────────
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=ap-south-1
S3_BUCKET_NAME=your_s3_bucket_name

# ──────────────────────────────────────────────
# Sentry (error tracking)
# ──────────────────────────────────────────────
SENTRY_DSN=https://your_key@sentry.io/your_project_id

# ──────────────────────────────────────────────
# Brevo (email) — set-password/rejection/team-invite emails
# ──────────────────────────────────────────────
BREVO_API_KEY=your_brevo_api_key
BREVO_FROM_EMAIL=noreply@vepaw.pk
BREVO_FROM_NAME=PawCare

# ──────────────────────────────────────────────
# Frontend URL (for email links)
# ──────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
